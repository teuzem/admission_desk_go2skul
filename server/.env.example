# PostgreSQL connection (app role, least privilege)
DATABASE_URL=postgresql://admission_app:CHANGE_ME@127.0.0.1:5432/admission_desk

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
APP_URL=http://localhost:5173

# Security — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME
COOKIE_SECRET=CHANGE_ME
# 32-byte hex key for AES-256-GCM encryption of TOTP secrets
MFA_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# Token lifetimes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# File storage
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# Email (SMTP). If SMTP_HOST is empty, emails are logged to console in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Admission Desk <noreply@admissiondesk.online>
SUPPORT_EMAIL=support@admissiondesk.online
PARTNERS_EMAIL=partners@admissiondesk.online

# Bootstrap super admin (created by seed script; change immediately)
SEED_ADMIN_EMAIL=admin@admissiondesk.local
SEED_ADMIN_PASSWORD=CHANGE_ME